<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="ChatGPT" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Маршрут до Технополис (бул. Санкт Петербург 133)</name>
    <desc>Препоръчителен маршрут ~10–15 минути при нормален трафик.</desc>
  </metadata>
  <rte>
    <name>Маршрут: жк Тракия → Технополис</name>
    <rtept lat="42.136100" lon="24.781000">
      <name>Старт (жк Тракия)</name>
      <desc>Тръгнете на запад по улица към бул. „Освобождение“.</desc>
    </rtept>
    <rtept lat="42.141500" lon="24.775000">
      <name>Бул. „Освобождение“</name>
      <desc>Продължете по бул. „Освобождение“ в посока центъра.</desc>
    </rtept>
    <rtept lat="42.149000" lon="24.765500">
      <name>Към бул. „Пещерско шосе“ / бул. „Санкт Петербург“</name>
      <desc>Следвайте бул. „Освобождение“ → бул. „Пещерско шосе“ / бул. „Санкт Петербург“ (на север/запад).</desc>
    </rtept>
    <rtept lat="42.153900" lon="24.754800">
      <name>Бул. „Санкт Петербург“ № 133 (Технополис)</name>
      <desc>Продължете до № 133 – Технополис ще бъде вдясно. Паркирайте на паркинга пред магазина.</desc>
    </rtept>
  </rte>
</gpx>
